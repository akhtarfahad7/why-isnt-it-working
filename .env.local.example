# AI Provider (gemini, openai, or none)
AI_PROVIDER=gemini

# Google Gemini API Key (Free tier: 15 requests/minute)
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=your_gemini_api_key_here

# Gemini Model (default: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI API Key (optional, for fallback)
AI_API_KEY=your_openai_api_key_here

# Supabase (optional, for caching)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Base URL (for sitemap, robots.txt, structured data)
NEXT_PUBLIC_BASE_URL=https://your-domain.com
